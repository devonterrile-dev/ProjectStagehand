# Server environment for local development. The server does not load .env files itself:
# set these in your shell (or your IDE's run config) before `pnpm --filter @stagehand/server dev`.

# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info

# Dev database from `pnpm db:up` (infra/docker-compose.dev.yml).
DATABASE_URL=postgres://stagehand:stagehand@127.0.0.1:5432/stagehand_dev

# Serve a built client (apps/web/dist) from the server, like production. Usually unset in dev,
# where Vite serves the client and proxies /api to the server.
# WEB_DIST_DIR=../web/dist
