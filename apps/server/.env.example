# Local development settings for the server.
#   cp apps/server/.env.example apps/server/.env
# `pnpm --filter @stagehand/server dev` and `pnpm db:migrate` load .env automatically
# (Node's --env-file-if-exists). Production never reads .env files: it uses infra/.env via Compose.

# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info

# Dev database from `pnpm db:up` (infra/docker-compose.dev.yml). Required outside unit tests.
DATABASE_URL=postgres://stagehand:stagehand@127.0.0.1:5432/stagehand_dev

# --- Sign in with Discord (F0.4) ---
# Where you open the app in dev: the Vite server, which proxies /api here. The Discord app
# needs the Redirect http://localhost:5173/api/auth/callback/discord
PUBLIC_URL=http://localhost:5173
# 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Discord Developer Portal > your application > OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Master key for GMs' stored AI keys (F1.7): exactly 32 random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing or losing it makes stored keys unreadable (GMs enter them again; nothing else is lost).
CREDENTIALS_ENCRYPTION_KEY=

# Folder holding the AI prompt files (import/v<N>.md, F1.9). Leave unset in dev: they are
# read from packages/prompts. The production image sets it to /app/prompts.
# PROMPTS_DIR=../../packages/prompts

# Folder holding the image style bible (v<N>/, F2.3). Leave unset in dev: it is read from
# packages/style-bible. The production image sets it to /app/style-bible.
# STYLE_BIBLE_DIR=../../packages/style-bible

# Where Generate visual stores images (F2.3). Leave unset in dev: apps/server/var/assets
# (git-ignored). The production image sets it to /app/data/assets, a Docker volume.
# ASSETS_DIR=var/assets

# Serve a built client (apps/web/dist) from the server, like production. Usually unset in dev,
# where Vite serves the client and proxies /api to the server.
# WEB_DIST_DIR=../web/dist
