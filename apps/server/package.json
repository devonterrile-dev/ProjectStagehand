{
  "name": "@stagehand/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsx scripts/build.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "eval": "tsx --env-file-if-exists=.env eval/import/cli.ts",
    "style:sample": "tsx --env-file-if-exists=.env eval/images/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --config src/auth/cli.ts --output src/db/schema/auth.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@fastify/static": "^10.1.10",
    "@stagehand/prompts": "workspace:*",
    "@stagehand/shared": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "~0.45.4",
    "fastify": "^5.12.8",
    "marked": "^18.2.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stagehand/style-bible": "workspace:*",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.18",
    "drizzle-kit": "~0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
