# Production stack settings. Copy to infra/.env (gitignored) and fill in.
# Never commit infra/.env: it holds the database password and the tunnel token.

# --- PostgreSQL ---
POSTGRES_USER=stagehand
# Generate a strong password, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Use URL-safe characters only: it is embedded in the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stagehand

# --- App ---
# Host port for checking the stack locally (bound to 127.0.0.1 only).
APP_PORT=8080
LOG_LEVEL=info

# --- Sign in with Discord (F0.4) ---
# The origin people open in their browser. Must match a Redirect in the Discord app:
#   <PUBLIC_URL>/api/auth/callback/discord
# Live (F0.5): https://projectstagehand.com. Local-only testing: http://localhost:8080.
PUBLIC_URL=https://projectstagehand.com
# Signs session cookies and encrypts stored Discord tokens. 32+ characters; changing it
# signs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Discord Developer Portal > your application > OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Backups (F0.6, D-19) ---
# `pnpm stack:shutdown` writes an encrypted, verified backup here before stopping the stack.
# Use a different physical disk from the one Docker's data is on (Docker Desktop: C:).
BACKUP_DIR=D:\StagehandBackups
# Encrypts every backup. KEEP IT IN YOUR PASSWORD MANAGER: without it, backups can't be
# read, and it is deliberately not stored inside them. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BACKUP_PASSPHRASE=
# How many backups to keep (newest first). Older ones are deleted after each new backup.
BACKUP_KEEP=30

# --- Cloudflare Tunnel (F0.5) ---
# Starts the cloudflared service with the rest of the stack on `pnpm stack:up`. Remove this
# line to run the stack locally without going live.
COMPOSE_PROFILES=tunnel
# Cloudflare dashboard > Networking > Tunnels > your tunnel: the long token after `--token`
# in the Docker install command. Anyone with it can serve traffic for your domain: keep it
# secret, and rotate it in the dashboard if it leaks.
CLOUDFLARE_TUNNEL_TOKEN=
