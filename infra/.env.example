# Production stack settings. Copy to infra/.env (gitignored) and fill in.
# Never commit infra/.env: it holds the database password and the tunnel token.

# --- PostgreSQL ---
POSTGRES_USER=stagehand
# Generate a strong password, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Use URL-safe characters only: it is embedded in the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stagehand

# --- App ---
# Host port for checking the stack locally (bound to 127.0.0.1 only).
APP_PORT=8080
LOG_LEVEL=info

# --- Cloudflare Tunnel (F0.5) ---
# Token from the Cloudflare dashboard: Zero Trust > Networks > Tunnels > your tunnel.
# Only used with `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
