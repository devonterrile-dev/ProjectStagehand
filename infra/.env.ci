# Throwaway settings for the CI Docker smoke test. Not used anywhere else.
POSTGRES_USER=stagehand
POSTGRES_PASSWORD=ci-only-not-a-secret
POSTGRES_DB=stagehand
APP_PORT=8080
LOG_LEVEL=info
# Sign-in config with dummy Discord credentials: CI smoke-tests the auth endpoints but never
# completes a real Discord sign-in.
PUBLIC_URL=http://localhost:8080
BETTER_AUTH_SECRET=ci-only-secret-not-used-anywhere-else-000000
DISCORD_CLIENT_ID=ci-dummy-client-id
DISCORD_CLIENT_SECRET=ci-dummy-client-secret
# Backups: dummy passphrase; CI sets BACKUP_DIR to a temp directory.
BACKUP_PASSPHRASE=ci-only-backup-passphrase
